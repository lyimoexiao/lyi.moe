---
import BaseHead from '../../components/BaseHead.astro'
import Footer from '../../components/Footer.astro'
import FriendApply from '../../components/FriendApply.astro'
import FriendGroup from '../../components/FriendGroup.astro'
import Header from '../../components/Header.astro'
import Twikoo from '../../components/Twikoo.astro'
import { siteDescription, siteTitle, twikooConfig } from '../../config'
import { getLocale, useTranslations } from '../../i18n/ui'
import { feeds } from '../../lib/feed'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
	<head>
		<BaseHead title={`${t('nav.friends')} - ${siteTitle(locale)}`} description={siteDescription(locale)} />
	</head>
	<body>
		<Header />
		<main class="px-4 py-16 sm:px-6">
			<div class="mx-auto max-w-3xl">
				<h1 class="font-title text-3xl tracking-tight font-700 text-balance">{t('nav.friends')}</h1>
				<hr class="my-8 border-base" />
				{
					feeds.map(group => (
						<FriendGroup group={group} />
					))
				}
				<FriendApply />
				{twikooConfig.envId && <Twikoo path="/friends" />}
			</div>
		</main>
		<Footer />
	</body>
</html>
