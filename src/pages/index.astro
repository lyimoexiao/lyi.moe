---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import avatar from '../assets/avatar.jpg'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import RandomBackground from '../components/RandomBackground.astro'
import TypeQuote from '../components/TypeQuote.astro'
import { getLocale, useTranslations } from '../i18n/ui'
import { getPosts } from '../lib/posts'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const prefix = `${locale}/`
const posts = (await getPosts(locale)).slice(0, 3)
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
	<head>
		<BaseHead title={t('site.title')} description={t('site.description')} />
	</head>
	<body>
		<RandomBackground />
		<Header />
		<main class="flex flex-col px-4 py-10 sm:justify-center sm:px-6 sm:py-16">
			<div class="mx-auto w-full max-w-3xl mt-auto sm:mt-0 bg-tinted">
	<Image
  src={avatar}
  alt="Lyi."
  width={160}
  height={160}
  loading="eager"
  class="img-outline rounded-full h-20 w-20"
		/>
				<h1 class="font-title text-3xl tracking-tight font-300 mt-6 text-balance">{t('site.title')}</h1>
				<TypeQuote />
				{
					posts.length > 0 && (
						<section>
							<hr class="my-10 border-base" />
							<h2 class="text-lg font-600 mb-6">{t('home.latest')}</h2>
							<ul class="flex flex-col">
								{
									posts.map(post => (
										<li>
											<a
  href={getRelativeLocaleUrl(locale, `blog/${post.id.slice(prefix.length)}`)}
  class="group px-2 py-2 rounded flex gap-4 items-baseline justify-between -mx-2"
											>
												<span class="flex gap-1 items-center">
													<span class="transition-colors group-hover:color-active">
														{post.data.title}
													</span>
													<span class="i-ph-arrow-up-right text-sm opacity-0 transition-[opacity,transform] duration-200 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0" />
												</span>
												<FormattedDate date={post.data.pubDate} />
											</a>
										</li>
									))
								}
							</ul>
						</section>
					)
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
