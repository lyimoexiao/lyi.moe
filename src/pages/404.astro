---
import { getRelativeLocaleUrl } from 'astro:i18n'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { getLocale, useTranslations } from '../i18n/ui'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const homeHref = getRelativeLocaleUrl(locale, '')
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
	<head>
		<BaseHead title={`${t('error.404.title')} - ${t('site.title')}`} description={t('error.404.description')} />
	</head>
	<body>
		<Header />
		<main class="px-4 py-16 flex flex-col sm:px-6">
			<div class="mx-auto text-center flex flex-col max-w-3xl items-center">
				<p class="font-title text-6xl tracking-tight font-700">404</p>
				<h1 class="text-3xl tracking-tight font-700 mt-6 text-balance">{t('error.404.title')}</h1>
				<p class="text-base mt-2 opacity-75">{t('error.404.description')}</p>
				<a
  href={homeHref}
  class="bg-text-1 text-bg-1 font-600 mt-8 px-6 py-2 rounded-full transition-opacity hover:opacity-80"
				>
					{t('error.backHome')}
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
