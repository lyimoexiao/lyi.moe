---
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { SITE_TITLE } from '../consts'
import { getLocale, useTranslations } from '../i18n/ui'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
	<head>
		<BaseHead title={`${t('about.title')} - ${SITE_TITLE}`} description={t('site.description')} />
	</head>
	<body>
		<Header />
		<main class="px-4 py-16 sm:px-6">
			<div class="mx-auto max-w-3xl">
				<h1 class="text-3xl tracking-tight font-700 text-balance">{t('about.title')}</h1>
				<hr class="my-8 border-base" />
				<div class="prose">
					<p>{t('about.body')}</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
