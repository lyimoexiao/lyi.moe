---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import { siteTitle } from '../config'
import { getLocale, useTranslations } from '../i18n/ui'

type Props = CollectionEntry<'blog'>['data']

const { title, description, pubDate, updatedDate, heroImage, license } = Astro.props
const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
---

<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
	<head>
		<BaseHead title={`${title} - ${siteTitle(locale)}`} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main class="px-4 py-12 sm:px-6">
			<article class="mx-auto max-w-3xl">
				{
					heroImage && (
					<Image
  src={heroImage}
  alt=""
  width={1020}
  height={510}
  loading="eager"
  class="img-outline rounded-lg"
					/>
					)
				}
				<header class="mt-8 max-w-[65ch]">
					<a href={getRelativeLocaleUrl(locale, 'blog')} class="btn-action-sm tap-scale">
						<span class="i-ph-arrow-left" />
						{t('blog.back')}
					</a>
					<div class="text-mini color-c-text-2 font-mono mt-6 flex gap-2 items-center tabular-nums">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span>
									&middot; {t('blog.updated')} <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1 class="font-title text-3xl tracking-tight font-700 mt-3 text-balance">{title}</h1>
					{
						license && (
							<a
  href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
  target="_blank"
  rel="noopener noreferrer"
  class="text-mini mt-6 op-mute inline-flex gap-1 transition-opacity items-center hover:op100"
							>
								<span class="i-fa6-brands-creative-commons" />
								{t('post.license')}
							</a>
						)
					}
					<hr class="my-8 border-base" />
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<script>
const labels = {
  zh: { copy: '复制', copied: '已复制' },
  en: { copy: 'Copy', copied: 'Copied' },
}

document.addEventListener('astro:page-load', () => {
  const lang = document.documentElement.lang.startsWith('zh') ? 'zh' : 'en'
  const { copy, copied } = labels[lang]
  for (const pre of document.querySelectorAll<HTMLElement>('.prose pre.astro-code')) {
    if (pre.dataset.copyBtn)
      continue
    pre.dataset.copyBtn = 'true'
    const btn = document.createElement('button')
    btn.type = 'button'
    btn.className = 'copy-btn'
    const icon = document.createElement('span')
    icon.className = 'i-ph-copy copy-icon'
    const label = document.createElement('span')
    label.className = 'copy-label'
    label.textContent = copy
    btn.append(icon, label)
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')
      if (!code)
        return
      try {
        await navigator.clipboard.writeText(code.textContent ?? '')
      }
      catch {
        // Clipboard unavailable; nothing to do.
      }
      btn.classList.add('copied')
      icon.classList.replace('i-ph-copy', 'i-ph-check')
      label.textContent = copied
      setTimeout(() => {
        btn.classList.remove('copied')
        icon.classList.replace('i-ph-check', 'i-ph-copy')
        label.textContent = copy
      }, 1500)
    })
    pre.appendChild(btn)
  }
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]')) {
    if (a.dataset.external)
      continue
    a.dataset.external = 'true'
    a.target = '_blank'
    a.rel = 'noopener noreferrer'
    const icon = document.createElement('span')
    icon.className = 'i-ph-arrow-up-right'
    icon.setAttribute('aria-hidden', 'true')
    a.append(icon)
  }
})
</script>
