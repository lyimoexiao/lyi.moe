---
// 友链页底部的“申请友链”要求：内容由 Markdown 维护，方便修改。
// 中英文分别对应 src/content/link/apply-zh.md / apply-en.md，
// 支持 `code`{copy} 与 :tip[文字]{tip="说明"} 语法（src/remark/ 插件）。
import { getCollection, render } from 'astro:content'
import { getLocale } from '../i18n/ui'

const isEn = getLocale(Astro.currentLocale) === 'en'
const [entry] = await getCollection('link', ({ id }) => id === (isEn ? 'apply-en' : 'apply-zh'))
const { Content } = await render(entry)
---

<section class="mt-14 pt-8 border-t border-base" aria-labelledby="friend-apply-title">
	<h2 id="friend-apply-title" class="font-title text-xl font-600">
		{isEn ? 'Apply for a friend link' : '申请友链'}
	</h2>
	<div class="friend-apply mt-4">
		<Content />
	</div>
</section>

<style is:global>
  /* 申请要求排版：颜色/圆角/字体全部取自站点设计令牌，自动跟随主题。 */
  .friend-apply {
    display: grid;
    gap: 0.75rem;
    color: var(--c-text-2);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  .friend-apply ul {
    display: grid;
    gap: 0.35rem;
    margin: 0.4rem 0 0;
    padding-left: 1.4rem;
    list-style: disc;
  }

  .friend-apply ul ul {
    list-style: circle;
    margin-top: 0.35rem;
  }

  .friend-apply strong {
    color: var(--c-text-1);
    font-weight: 600;
  }

  .friend-apply code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: var(--c-bg-3);
    border-radius: 4px;
    padding: 0.15em 0.4em;
  }

  .friend-apply pre {
    margin: 0.6rem 0 0.15rem;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    background-color: var(--c-bg-2);
    border: 1px solid var(--c-border);
    border-radius: 10px;
  }

  .friend-apply pre code {
    background: none;
    padding: 0;
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .friend-apply a {
    color: var(--c-accent-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--c-accent-text) 35%, transparent);
    transition: opacity 0.2s;
  }

  .friend-apply a:hover {
    opacity: 0.75;
  }
</style>
