---
import type { ImageMetadata } from 'astro'
import { Font } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { ClientRouter } from 'astro:transitions'
import { siteTitle } from '../config'
import { getLocale } from '../i18n/ui'
// Import the stylesheets here so that they are included on
// all pages through the use of the <BaseHead /> component.
import '../styles/fonts.css'
import '../styles/theme.css'
import '../styles/base.css'
import '../styles/prose.css'
import '../styles/friend-image.css'
import '../styles/markdown-widgets.css'

interface Props {
	title: string
	description: string
	image?: ImageMetadata
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const locale = getLocale(Astro.currentLocale)
const rssURL = new URL(getRelativeLocaleUrl(locale, 'rss.xml').replace(/\/$/, ''), Astro.site)

const { title, description, image } = Astro.props;
---

<script is:inline>
function applyTheme() {
  let stored = null
  try {
    stored = localStorage.getItem('theme')
  }
  catch {
    stored = null
  }
  const dark = stored
    ? stored === 'dark'
    : window.matchMedia('(prefers-color-scheme: dark)').matches
  document.documentElement.classList.toggle('dark', dark)
  document.documentElement.classList.toggle('light', !dark)
}
document.addEventListener('astro:after-swap', applyTheme)
applyTheme()
</script>

<script>
// `code`{copy} 复制按钮：点击把 data-copy 文本写入剪贴板，成功后短暂显示对勾。
// 无 Clipboard API（如非安全上下文）时回退 execCommand；View Transitions 换页后重新扫描。
;(() => {
  async function copyText(text: string) {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text)
        return true
      }
      catch {
        // 继续走 legacy 回退
      }
    }
    const area = document.createElement('textarea')
    area.value = text
    area.style.position = 'fixed'
    area.style.opacity = '0'
    document.body.appendChild(area)
    area.select()
    let ok = false
    try {
      ok = document.execCommand('copy')
    }
    catch {
      ok = false
    }
    area.remove()
    return ok
  }

  const init = () => {
    document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((el) => {
      if (el.dataset.copyInit)
        return
      el.dataset.copyInit = '1'
      const text = el.dataset.copy ?? ''
      const copiedLabel = document.documentElement.lang.startsWith('zh') ? '已复制' : 'Copied'
      const originalLabel = el.getAttribute('aria-label') ?? ''
      const flash = () => {
        el.classList.add('copied')
        el.setAttribute('aria-label', copiedLabel)
        window.setTimeout(() => {
          el.classList.remove('copied')
          if (originalLabel)
            el.setAttribute('aria-label', originalLabel)
          else
            el.removeAttribute('aria-label')
        }, 1600)
      }
      el.addEventListener('click', async () => {
        if (!text)
          return
        if (await copyText(text)) {
          flash()
        }
        else {
          // 剪贴板不可用：选中按钮文本，方便手动 Ctrl/Cmd+C
          const range = document.createRange()
          range.selectNodeContents(el)
          const selection = getSelection()
          selection?.removeAllRanges()
          selection?.addRange(range)
        }
      })
    })
  }

  // 代码块复制按钮：文章与友链申请页的 astro-code 代码块共用，
  // 注入右上角“复制”按钮，点击复制整块代码。
  const initCodeCopy = () => {
    const lang = document.documentElement.lang.startsWith('zh') ? 'zh' : 'en'
    const copy = lang === 'zh' ? '复制' : 'Copy'
    const copied = lang === 'zh' ? '已复制' : 'Copied'
    for (const block of document.querySelectorAll<HTMLElement>('.z-codeblock')) {
      if (block.dataset.copyBtn)
        continue
      const pre = block.querySelector('pre.astro-code')
      const operations = block.querySelector('.code-operations')
      if (!pre || !operations)
        continue
      block.dataset.copyBtn = 'true'
      const code = pre.querySelector('code')
      const btn = document.createElement('button')
      btn.type = 'button'
      btn.className = 'copy-btn'
      const icon = document.createElement('span')
      icon.className = 'i-ph-copy copy-icon'
      const label = document.createElement('span')
      label.className = 'copy-label'
      label.textContent = copy
      btn.append(icon, label)
      btn.addEventListener('click', async () => {
        if (!code || !(await copyText(code.textContent ?? '')))
          return
        btn.classList.add('copied')
        icon.classList.replace('i-ph-copy', 'i-ph-check')
        label.textContent = copied
        window.setTimeout(() => {
          btn.classList.remove('copied')
          icon.classList.replace('i-ph-check', 'i-ph-copy')
          label.textContent = copy
        }, 1500)
      })
      operations.appendChild(btn)
    }
  }
  document.addEventListener('astro:page-load', init)
  document.addEventListener('astro:page-load', initCodeCopy)
  init()
  initCodeCopy()
})()
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteTitle(locale)}
  href={rssURL}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Alimama FangYuanTi VF subsets (latin + CJK), used by the home title
     and nav links; both are tiny and on the first screen. -->
<link rel="preload" href="/fonts/alimama-fangyuanti/AlimamaFangYuanTiVF-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/alimama-fangyuanti/AlimamaFangYuanTiVF-cjk.woff2" as="font" type="font/woff2" crossorigin />

<!-- JetBrains Mono subset, used by code blocks. -->
<link rel="preload" href="/fonts/jetbrains-mono/JetBrainsMono-latin.woff2" as="font" type="font/woff2" crossorigin />

<ClientRouter />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
