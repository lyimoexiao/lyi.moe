---
import type { ImageMetadata } from 'astro'
import { Font } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { ClientRouter } from 'astro:transitions'
import { SITE_TITLE } from '../consts'
import { getLocale } from '../i18n/ui'
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css'

interface Props {
	title: string
	description: string
	image?: ImageMetadata
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const rssURL = new URL(getRelativeLocaleUrl(getLocale(Astro.currentLocale), 'rss.xml').replace(/\/$/, ''), Astro.site)

const { title, description, image } = Astro.props;
---

<script is:inline>
// Set the theme before first paint to avoid a flash of the wrong theme.
function applyTheme() {
  let stored = null
  try {
    stored = localStorage.getItem('theme')
  }
  catch {
    // localStorage unavailable; fall back to the OS preference.
  }
  const dark = stored
    ? stored === 'dark'
    : window.matchMedia('(prefers-color-scheme: dark)').matches
  document.documentElement.classList.toggle('dark', dark)
  document.documentElement.classList.toggle('light', !dark)
}
// Re-apply after client-side navigation: the incoming document's class
// list does not carry the theme over from the current page.
document.addEventListener('astro:after-swap', applyTheme)
applyTheme()
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={rssURL}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<ClientRouter />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
