---
interface Props {
	date: Date
}

const { date } = Astro.props
const locale = Astro.currentLocale === 'en' ? 'en-US' : 'zh-CN'
---

<time datetime={date.toISOString()} class="text-mini font-mono op-mute tabular-nums">
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
