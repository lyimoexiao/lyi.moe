---
interface Props {
	date: Date
	/** Text tone: `muted` (default) for normal pages, `light` for image banners. */
	tone?: 'muted' | 'light'
}

const { date, tone = 'muted' } = Astro.props
const locale = Astro.currentLocale === 'en' ? 'en-US' : 'zh-CN'
---

<time
  datetime={date.toISOString()}
  class:list={['text-xs font-mono tabular-nums', tone === 'light' ? 'text-white/70' : 'color-c-text-2']}
>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
