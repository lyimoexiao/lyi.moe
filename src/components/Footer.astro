---
import { SITE_TITLE } from '../consts'
import { getLocale, useTranslations } from '../i18n/ui'

const today = new Date()
const t = useTranslations(getLocale(Astro.currentLocale))
---

<footer class="border-t border-base">
	<div class="px-4 py-8 flex gap-4 items-center justify-between sm:px-6">
		<div class="flex flex-col gap-0.5">
			<a
  href="https://icp.gov.moe/?keyword=20250725"
  target="_blank"
  rel="noopener noreferrer"
  class="text-sm op-mute inline-flex gap-1 transition-opacity items-center hover:op100"
			>
				萌ICP备20250725号
			</a>
			<p class="text-sm op-mute inline-flex gap-1 items-center">
				<span class="i-ph-copyright" />
				{today.getFullYear()} {SITE_TITLE}
			</p>
		</div>
		<a
  href="https://github.com/lyimoexiao"
  target="_blank"
  rel="noopener noreferrer"
  class="btn-icon tap-scale"
  aria-label={t('footer.github')}
  title={t('footer.github')}
		>
			<span class="i-ph-github-logo" />
		</a>
	</div>
</footer>
