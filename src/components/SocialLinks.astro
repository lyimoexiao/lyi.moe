---
import { siteConfig } from '../config'
---

<div class="mt-4 flex gap-3">
	{
		siteConfig.social.map(link => (
			<a
  href={link.href}
  target="_blank"
  rel="noopener noreferrer"
  class={`rounded inline-flex h-10 w-10 tap-scale transition-colors items-center justify-center ${siteConfig.socialStyle.color}  ${link.hoverColor ?? siteConfig.socialStyle.hoverColor}  ${link.hoverBg ?? siteConfig.socialStyle.hoverBg}`}
  aria-label={link.name}
  title={link.name}
			>
				<span class={link.icon} />
			</a>
		))
	}
</div>
