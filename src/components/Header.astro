---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import avatar from '../assets/avatar.jpg'
import { siteTitle } from '../config'
import { getLocale, useTranslations } from '../i18n/ui'
import HeaderLink from './HeaderLink.astro'
import LoadingIndicator from './LoadingIndicator.astro'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const otherLang = locale === 'en' ? 'zh-cn' : 'en'
const rawPath = Astro.url.pathname
const noPrefix = rawPath.startsWith('/en') ? (rawPath.slice(3) || '/') : rawPath
const otherHref = otherLang === 'en' ? (noPrefix === '/' ? '/en' : `/en${noPrefix}`) : noPrefix
const isHome = noPrefix === '/'
const homeHref = getRelativeLocaleUrl(locale, '')
const navLinks = [
  { href: getRelativeLocaleUrl(locale, ''), label: t('nav.home') },
  { href: getRelativeLocaleUrl(locale, 'blog'), label: t('nav.blog') },
  { href: getRelativeLocaleUrl(locale, 'links'), label: t('nav.friends') },
  { href: getRelativeLocaleUrl(locale, 'about'), label: t('nav.about') },
]
---

<header class="top-0 sticky z-top-nav">
	<div
  id="header-bg"
  transition:persist
  aria-hidden="true"
  class:list={['absolute inset-0 -z-1 border-b transition-[background-color,border-color] duration-300', isHome ? 'bg-transparent border-transparent' : 'bg-nav border-base']}
	/>
	<LoadingIndicator />
	<nav class="px-4 flex h-14 items-center sm:px-6">
		{!isHome && (
			<a
  href={homeHref}
  class="font-title tracking-tight font-300 flex gap-2 transition-opacity items-center hover:op80"
  title={siteTitle(locale)}
			>
				{/* transition:persist 让头像在内容页之间的导航中保持同一元素；
				     首页 ↔ 内容页的“飞入”由下方 anime.js FLIP 动画负责。 */}
				<span transition:persist class="contents">
					<Image
  src={avatar}
  alt=""
  width={160}
  height={160}
  class="img-outline rounded-full h-7 w-7 object-cover"
  data-nav-avatar
					/>
				</span>
				<span data-nav-title class="inline-block">{siteTitle(locale)}</span>
			</a>
		)}
		<div class:list={['flex gap-1 items-center ml-auto px-1.5', isHome && 'bg-nav rounded-full']}>
			<div class="gap-1 hidden items-center sm:flex">
				{
					navLinks.map(link => (
						<HeaderLink href={link.href}>{link.label}</HeaderLink>
					))
				}
			</div>
			<a
  href={otherHref}
  class="nav-link"
  aria-label={t('lang.switch')}
  title={t('lang.switch')}
			>
				{otherLang === 'en' ? 'EN' : '中'}
			</a>
			<button
  id="theme-toggle"
  type="button"
  class="btn-header h-10 w-10 relative overflow-hidden"
  aria-label={t('theme.toggle')}
  title={t('theme.toggle')}
			>
				<span class="i-ph-sun text-lg m-auto transition-[opacity,transform,filter] duration-300 inset-0 absolute dark:op-0 dark:scale-50 dark:blur-sm" />
				<span class="i-ph-moon text-lg m-auto op-0 scale-50 transition-[opacity,transform,filter] duration-300 inset-0 absolute blur-sm dark:op-100 dark:scale-100 dark:blur-0" />
			</button>
			<details class="relative sm:hidden">
				<summary
  class="list-none btn-header h-10 w-10 cursor-pointer [&::-webkit-details-marker]:hidden [&::marker]:content-none"
  aria-label={t('nav.menu')}
  title={t('nav.menu')}
				>
					<span class="i-ph-list text-lg m-auto" />
				</summary>
				<nav class="mt-2 p-1 border border-base rounded-lg bg-nav w-40 shadow-lg right-0 top-full absolute">
					{
						navLinks.map(link => (
							<HeaderLink href={link.href} class="px-3 py-2 block">{link.label}</HeaderLink>
						))
					}
				</nav>
			</details>
		</div>
	</nav>
</header>

<script>
import { animate } from 'animejs'

const root = document.documentElement
const isHomePath = () => (location.pathname.replace(/^\/en/, '') || '/') === '/'
const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches

// 首页 hero ↔ nav 的“飞入”过渡：anime.js FLIP。
// 导航前记录旧元素位置，换页后先把新元素按旧位置/旧尺寸摆好，再以非线性缓动
// 飞回原位——title 的落点与 nav 完全一致（原生共享元素过渡会因 h1 的整行宽盒
// 导致最终位置偏移）。
let flyFrom: { avatar: DOMRect | null, title: DOMRect | null, fromHome: boolean } | null = null

function homeEls(home: boolean) {
  return {
    avatar: document.querySelector(home ? '[data-hero-avatar]' : '[data-nav-avatar]'),
    title: document.querySelector(home ? '[data-hero-title]' : '[data-nav-title]'),
  }
}

document.addEventListener('astro:before-swap', () => {
  const home = isHomePath()
  const els = homeEls(home)
  flyFrom = {
    avatar: els.avatar?.getBoundingClientRect() ?? null,
    title: els.title?.getBoundingClientRect() ?? null,
    fromHome: home,
  }
})

document.addEventListener('astro:after-swap', () => {
  if (!flyFrom)
    return
  const { avatar, title, fromHome } = flyFrom
  flyFrom = null
  const toHome = isHomePath()
  if (fromHome === toHome || reduceMotion)
    return
  const els = homeEls(toHome)
  if (avatar && els.avatar)
    flyTo(els.avatar, avatar)
  if (title && els.title)
    flyTo(els.title, title)
})

function flyTo(el: Element, from: DOMRect) {
  const to = el.getBoundingClientRect()
  if (!from.width || !from.height || !to.width || !to.height)
    return
  const target = el as HTMLElement
  // 统一等比缩放（保持宽高比），避免文字/头像被非等比拉伸变形。
  const s = Math.max(from.width / to.width, from.height / to.height)
  target.style.transformOrigin = 'top left'
  target.style.transform = `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${s})`
  animate(target, {
    x: 0,
    y: 0,
    scale: 1,
    duration: 650,
    ease: 'outExpo',
    onComplete: () => {
      target.style.transform = ''
      target.style.transformOrigin = ''
    },
  })
}

// The background layer survives navigation via transition:persist; flip its
// classes so the color/border cross-fades only when the home state changes.
document.addEventListener('astro:page-load', () => {
  const bg = document.getElementById('header-bg')
  if (!bg)
    return
  bg.classList.toggle('bg-nav', !isHomePath())
  bg.classList.toggle('border-base', !isHomePath())
  bg.classList.toggle('bg-transparent', isHomePath())
  bg.classList.toggle('border-transparent', isHomePath())
})

// Event delegation so the handler survives client-side navigation,
// which replaces the button element on every page swap.
document.addEventListener('click', (event) => {
  const target = event.target
  if (!(target instanceof Element) || !target.closest('#theme-toggle'))
    return
  const dark = root.classList.toggle('dark')
  root.classList.toggle('light', !dark)
  try {
    localStorage.setItem('theme', dark ? 'dark' : 'light')
  }
  catch {
    // Ignore; theme still applies for this page.
  }
})
</script>
