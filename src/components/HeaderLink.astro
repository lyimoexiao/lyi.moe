---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...props } = Astro.props
const hrefString = typeof href === 'string' ? href : href?.toString() ?? ''
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '')
const segments = pathname.split('/').filter(Boolean)
// Drop the language prefix so section matching works for both locales.
const section = segments[0] === 'en' ? segments.slice(1) : segments
const hrefSegments = hrefString.split('/').filter(Boolean).filter(s => s !== 'en')
const isActive = hrefSegments.length === 0
  ? section.length === 0
  : section.length >= hrefSegments.length && section.slice(0, hrefSegments.length).join('/') === hrefSegments.join('/')
---

<a
  href={href}
  class:list={[
		'nav-link',
		isActive ? 'color-base font-semibold' : 'op-fade hover:op100',
		className,
	]}
  {...props}
>
	<slot />
</a>
