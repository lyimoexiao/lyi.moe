{
  "framework": "astro",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://lyi.moe/friends",
      "statusCode": 308,
      "has": [
        {
          "type": "host",
          "value": "blog.lyi.moe"
        }
      ]
    }
  ]
}
